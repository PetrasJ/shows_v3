{% block form_row %}
    <div class="row mb-3">
        <div class="col-4">
            {{ form_label(form, null, {'label_attr': {'class': 'form-label'}}) }}
        </div>
        <div class="col-8">
            {{ form_errors(form) }}
            {{ form_widget(form) }}
        </div>
    </div>
{% endblock form_row %}

{{ form_start(form) }}
{{ form_errors(form) }}
{{ form_widget(form) }}
{{ form_end(form) }}